{
  "extends": "./tsconfig.json",
  "include": ["src", "package", "*.d.ts"],
  "exclude": ["test", "**/*.spec.{js,ts}"],
  "compilerOptions": {
    "outDir": "dist",

    "emitDeclarationOnly": false,
    "noEmit": false,

    "declaration": true,
    "sourceMap": false,

    "preserveSymlinks": false
  }
}
