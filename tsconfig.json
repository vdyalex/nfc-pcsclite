{
  "include": ["src"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",

    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "typeRoots": ["./node_modules/@types", "*.d.ts"],

    "paths": {
      "lib:*": ["./src/lib/*"]
    }
  }
}
